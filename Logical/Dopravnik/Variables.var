VAR
	conOn : BOOL := FALSE; (*HMI tlacitko*)
	conSt : BOOL := FALSE; (*HMI tlacitko*)
	conSpp : BOOL := FALSE; (*HMI tlacitko*)
	conSpm : BOOL := FALSE; (*HMI tlacitko*)
	butEn : BOOL := FALSE; (*Zamek tlacitek*)
	do_OnOff : BOOL := FALSE; (*Dig. vystup pro MCU - Zapnuto/vypnuto*)
	do_Start : BOOL := FALSE; (*Dig. vystup pro  MCU - Start*)
	do_SpP : BOOL := FALSE; (*Dig. vystup pro MCU - zrychleni*)
	do_SpM : BOOL := FALSE; (*Dig. vystup pro MCU - zpomaleni*)
	tmp_actCmd : USINT := 0; (*Pomocna pro aktualni prikaz*)
	fb_Timer : TON; (*Casovac pro korekci zákmitù a generovaní zpozdeni mezi signaly*)
	fb_Pulse : TP; (*Pulse pro udrzeni aktivni hodnoty pro MCU*)
	trig_On : R_TRIG; (*Nabezna hrana On*)
	trig_Start : R_TRIG; (*Nabezna hrana Start*)
	trig_Plus : R_TRIG; (*Nabezna hrana zrychleni*)
	trig_Minus : R_TRIG; (*Nabezna hrana zpomaleni*)
	state : USINT := 0; (*stav stavoveho automatu*)
END_VAR
